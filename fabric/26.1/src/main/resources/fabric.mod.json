{
  "schemaVersion": 1,
  "id": "lazoboombox",
  "version": "${version}",
  "name": "LazoBoombox",
  "description": "Portable + placeable Boombox addon for LazoDiscs.",
  "authors": [
    "EyeCrasher"
  ],
  "license": "GPL-3.0-only",
  "icon": "assets/lazoboombox/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.eyecrasher.lazoboombox.LazoBoombox"
    ],
    "client": [
      "com.eyecrasher.lazoboombox.LazoBoomboxClient"
    ]
  },
  "mixins": [
    "lazoboombox.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "26.1",
    "java": ">=25",
    "plasmovoice": ">=2.1.8",
    "lazodiscs": ">=1.0.6"
  },
  "suggests": {
    "sable": "*"
  },
  "accessWidener": "lazoboombox.accesswidener"
}
